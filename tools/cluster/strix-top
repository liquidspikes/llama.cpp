def build_node_card(
    name: str,
    role_label: str,
    host: str,
    uptime: str,
    cpu_pct: float,
    cpu_temp: float,
    gpu_busy: float,
    sclk: str,
    mclk: str,
    power: float,
    gpu_temp: float,
    vram_used: float,
    vram_total: float,
    ram_used: float,
    ram_total: float,
    npu_avail: bool,
    npu_tops: int,
    npu_util: float,
    npu_tasks: int,
    npu_max_tasks: int,
    npu_clock: int,
    llm_role: str,
    is_local: bool,
    border_color: str
) -> Panel:
    t = Table.grid(padding=(0, 1), expand=True)
    t.add_column(ratio=4)
    t.add_column(ratio=6)

    badge = "[bold white on dark_green] LOCAL [/bold white on dark_green]" if is_local else "[bold white on purple] PEER [/bold white on purple]"
    t.add_row(Text.from_markup("Host & Role:"), Text.from_markup(f"[bold cyan]{host}[/bold cyan] ({role_label}) {badge}"))
    t.add_row(Text.from_markup("Uptime:"), Text.from_markup(f"[yellow]{uptime}[/yellow] · Kernel [dim]7.3.0-rc1[/dim]"))

    # CPU bar
    cpu_col = "green" if cpu_pct < 60 else "yellow" if cpu_pct < 85 else "red"
    cpu_bar = make_bar(cpu_pct, width=11, fill_color=cpu_col)
    cpu_t = Text()
    cpu_t.append_text(cpu_bar)
    cpu_t.append(f" {cpu_pct:4.1f}% ", style="bold white")
    if cpu_temp:
        cpu_t.append(f"({cpu_temp:.0f}°C)", style="dim")
    t.add_row(Text.from_markup("Zen 5 CPU (32t):"), cpu_t)

    # GPU Engine
    gpu_bar = make_bar(gpu_busy, width=11, fill_color="magenta")
    gpu_t = Text()
    gpu_t.append_text(gpu_bar)
    gpu_t.append(f" {gpu_busy:4.1f}% ", style="bold white")
    if gpu_temp:
        gpu_t.append(f"({gpu_temp:.0f}°C)", style="dim")
    t.add_row(Text.from_markup("RDNA 3.5 Engine:"), gpu_t)

    # Clocks & Power
    clock_str = f"[bold green]{sclk}[/bold green] · [bold green]{mclk}[/bold green] · [yellow]{power:.0f}W[/yellow] [dim](Pinned)[/dim]"
    t.add_row(Text.from_markup("Clocks / Pwr:"), Text.from_markup(clock_str))

    # Dedicated VRAM
    vram_pct = (vram_used / vram_total * 100.0) if vram_total > 0 else 0.0
    vram_bar = make_bar(vram_pct, width=11, fill_color="cyan" if vram_pct < 75 else "yellow")
    vram_t = Text()
    vram_t.append_text(vram_bar)
    vram_t.append(f" {vram_used:4.1f}/{vram_total:.0f}G ({vram_pct:4.1f}%)", style="bold cyan")
    t.add_row(Text.from_markup("Dedicated VRAM:"), vram_t)

    # System RAM
    ram_pct = (ram_used / ram_total * 100.0) if ram_total > 0 else 0.0
    ram_bar = make_bar(ram_pct, width=11, fill_color="blue")
    ram_t = Text()
    ram_t.append_text(ram_bar)
    ram_t.append(f" {ram_used:4.1f}/{ram_total:.0f}G ({ram_pct:4.1f}%)", style="bold blue")
    t.add_row(Text.from_markup("System Memory:"), ram_t)

    # NPU & LLM
    if npu_avail:
        npu_col = "green" if npu_util < 50 else "yellow" if npu_util < 80 else "bold green"
        npu_bar = make_bar(npu_util, width=11, fill_color=npu_col)
        npu_t = Text()
        npu_t.append_text(npu_bar)
        npu_t.append(f" {npu_util:4.1f}% ", style="bold white")
        npu_t.append_text(Text.from_markup(f"[green]XDNA 2[/green] [cyan]{npu_tops}T[/cyan] ({npu_tasks}/{npu_max_tasks}t) [dim]{npu_clock}MHz[/dim]"))
    else:
        npu_t = Text.from_markup("[dim]Offline[/dim]")
    t.add_row(Text.from_markup("XDNA 2 NPU:"), npu_t)

    t.add_row(Text.from_markup("LLM Workload:"), Text.from_markup(f"[bold bright_magenta]{llm_role}[/bold bright_magenta]"))

    return Panel(
        t,
        title=f"[bold {border_color}]{name}[/bold {border_color}]",
        box=box.ROUNDED,
        border_style=border_color
    )


def build_waveforms_panel(hist: ClusterHistory, curr_dma_mode: str) -> Panel:
