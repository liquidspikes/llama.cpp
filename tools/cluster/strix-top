def build_core_matrix_view(core_details: List[Dict[str, Any]], local_host: str) -> Panel:
    """Renders all 32 logical cores in classic dual-column htop meter format."""
    grid = Table.grid(padding=(0, 2), expand=True)
    grid.add_column(ratio=1)
    grid.add_column(ratio=1)

    for i in range(16):
        t_left = i
        t_right = i + 16

        c_left = next((x for x in core_details if x["cpu_idx"] == t_left), None)
        c_right = next((x for x in core_details if x["cpu_idx"] == t_right), None)

        p_left = c_left["pct"] if c_left else 0.0
        f_left = c_left["freq_mhz"] if c_left else 2000
        ccd_l = c_left["ccd"] if c_left else 0

        p_right = c_right["pct"] if c_right else 0.0
        f_right = c_right["freq_mhz"] if c_right else 2000
        ccd_r = c_right["ccd"] if c_right else 0

        # Left thread text
        l_txt = Text()
        l_col = "cyan" if ccd_l == 0 else "magenta"
        l_txt.append(f"{t_left:2d} ", style=f"bold {l_col}")
        l_txt.append("[", style="dim")
        l_bar = make_bar(p_left, width=10, fill_color="green" if p_left < 70 else "yellow")
        l_txt.append_text(l_bar)
        l_txt.append(f" {p_left:4.1f}%]", style="bold white")
        l_txt.append(f" {f_left/1000:.2f}G", style="dim green")
        if ccd_l == 1:
            pin = "tb0" if (t_left % 16) < 12 else "tb1"
            l_txt.append(f" [{pin}]", style="bold yellow")

        # Right thread text
        r_txt = Text()
        r_col = "cyan" if ccd_r == 0 else "magenta"
        r_txt.append(f"{t_right:2d} ", style=f"bold {r_col}")
        r_txt.append("[", style="dim")
        r_bar = make_bar(p_right, width=10, fill_color="green" if p_right < 70 else "yellow")
        r_txt.append_text(r_bar)
        r_txt.append(f" {p_right:4.1f}%]", style="bold white")
        r_txt.append(f" {f_right/1000:.2f}G", style="dim green")
        if ccd_r == 1:
            pin = "tb0" if (t_left % 16) < 12 else "tb1"
            r_txt.append(f" [{pin}]", style="bold yellow")

        grid.add_row(l_txt, r_txt)

    title_str = f"[bold white]🧬 Zen 5 Topology ({local_host}) · [cyan]CCD0 (0-7)[/cyan] · [magenta]CCD1 (8-15)[/magenta][/bold white]"
    return Panel(grid, title=title_str, box=box.ROUNDED, border_style="bright_blue")


