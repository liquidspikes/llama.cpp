def render_ui(
    hist: ClusterHistory,
    active_view: str,
    sort_key: str,
    ai_only: bool,
    interval: float,
    paused: bool,
    show_help: bool,
    local_host: str
) -> Group:
    is_n1 = (local_host == "bosgame1")
    peer_ip = "192.168.137.52" if is_n1 else "192.168.137.51"
    peer_host = "bosgame2" if is_n1 else "bosgame1"

    # 1. Collect local stats
    cpu_pct, cpu_temp, core_details = get_local_cpu_stats()
    gpu = get_local_gpu_stats()
    mem = get_local_memory_stats()
    npu = get_local_npu_stats()
    dma_rate, dma_mode, _ = get_local_dma_stats()
    kfd_vram = get_kfd_vram_map()
    local_procs = get_local_processes(kfd_vram, all_procs=(not ai_only))

    # 2. Update waveforms (only if not paused)
    if not paused:
        hist.update(cpu_pct, gpu["busy"], npu["util_pct"], dma_rate)

    # 3. Collect peer stats
    peer = fetch_peer_data(peer_ip)
    remote_procs = []
    if peer and "error" not in peer:
        p_cpu = float(peer.get("cpu", {}).get("usage_percent", 0.0))
        p_cpu_temp = float(peer.get("cpu", {}).get("temperature_c", 0.0))
        p_gpu_busy = float(peer.get("gpu", {}).get("busy_percent", 0.0))
        p_sclk = peer.get("gpu", {}).get("sclk", "2900MHz")
        p_mclk = peer.get("gpu", {}).get("mclk", "1000MHz")
        p_power = float(peer.get("gpu", {}).get("power_watts", 0.0))
        p_gpu_temp = float(peer.get("gpu", {}).get("temperature_c", 0.0))
        p_vram_used = float(peer.get("gpu", {}).get("vram_used_gb", 0.0))
        p_vram_total = float(peer.get("gpu", {}).get("vram_total_gb", 64.0))
        p_ram_used = float(peer.get("memory", {}).get("system_used_gb", 0.0))
        p_ram_total = float(peer.get("memory", {}).get("system_total_gb", 62.4))
        p_npu_avail = peer.get("npu", {}).get("available", True)
        p_npu_tops = peer.get("npu", {}).get("tops_curr", 58)
        p_npu_util = float(peer.get("npu", {}).get("utilization_percent", 0.0))
        p_npu_tasks = int(peer.get("npu", {}).get("tasks_active", 0))
        p_npu_max_tasks = int(peer.get("npu", {}).get("tasks_max", 16))
        p_npu_clock = int(peer.get("npu", {}).get("h_clock_mhz", 1800))
        p_uptime = peer.get("system", {}).get("uptime", "--")
        p_llm_role = peer.get("llm", {}).get("role", "Compute Worker (DMA)")

        # Remote processes
        raw_r_procs = peer.get("processes", [])
        for rp in raw_r_procs:
            remote_procs.append({
                "pid": rp.get("pid", 0),
                "node": peer_host,
                "user": rp.get("user", "user"),
                "role": rp.get("role", "Worker"),
                "comm": rp.get("comm", ""),
                "threads": rp.get("threads", 1),
                "cpu_pct": 0.0,
                "rss_gb": rp.get("rss_gb", 0.0),
                "vram_gb": rp.get("vram_gb", 0.0),
                "cmd": rp.get("cmd", ""),
            })
    else:
        p_cpu = p_cpu_temp = p_gpu_busy = p_power = p_gpu_temp = p_vram_used = p_ram_used = 0.0
        p_sclk = "2900MHz"
        p_mclk = "1000MHz"
        p_vram_total = 64.0
        p_ram_total = 62.4
        p_npu_avail = False
        p_npu_tops = 0
        p_npu_util = 0.0
        p_npu_tasks = 0
        p_npu_max_tasks = 16
        p_npu_clock = 0
        p_uptime = "Reconnecting..."
        p_llm_role = "Worker Standby"

    # Merge processes
    all_procs = local_procs + remote_procs
    if sort_key == "vram":
        all_procs.sort(key=lambda x: (x["vram_gb"], x["rss_gb"]), reverse=True)
    elif sort_key == "ram":
        all_procs.sort(key=lambda x: (x["rss_gb"], x["vram_gb"]), reverse=True)
    elif sort_key == "pid":
        all_procs.sort(key=lambda x: x["pid"])
    else:
        all_procs.sort(key=lambda x: (x["vram_gb"], x["threads"]), reverse=True)

    # Local uptime
    try:
        with open("/proc/uptime") as f:
            secs = float(f.readline().split()[0])
            m, s = divmod(int(secs), 60)
            h, m = divmod(m, 60)
            loc_uptime = f"{h}h {m}m {s}s"
    except Exception:
        loc_uptime = "--"

    loc_llm_role = "Master Inference (TP)" if is_n1 else "Compute Worker (DMA)"

    header = build_header_banner()
    footer = build_footer(active_view, sort_key, ai_only, interval, paused)

    if show_help:
        return Group(header, build_help_modal(), footer)

    if active_view == VIEW_CORES:
        core_panel = build_core_matrix_view(core_details, local_host)
        return Group(header, core_panel, footer)

    if active_view == VIEW_PROCESSES:
        proc_panel = build_full_process_explorer(all_procs, sort_key, ai_only, scroll_offset=0, max_rows=16)
        return Group(header, proc_panel, footer)

    # Default: VIEW_OVERVIEW
    if is_n1:
        n1_box = build_node_card(
            "NODE 1: bosgame1 (Master)", "Orchestrator", "bosgame1", loc_uptime,
            cpu_pct, cpu_temp, gpu["busy"], gpu["sclk"], gpu["mclk"], gpu["power"], gpu["temp"],
            gpu["vram_used"], gpu["vram_total"], mem["system_used"], mem["system_total"],
            npu["available"], npu["tops"], npu["util_pct"], npu["tasks_active"], npu["tasks_max"], npu["clock_mhz"],
            loc_llm_role, True, "cyan"
        )
        n2_box = build_node_card(
            "NODE 2: bosgame2 (Worker)", "Compute Worker", "bosgame2", p_uptime,
            p_cpu, p_cpu_temp, p_gpu_busy, p_sclk, p_mclk, p_power, p_gpu_temp,
            p_vram_used, p_vram_total, p_ram_used, p_ram_total,
            p_npu_avail, p_npu_tops, p_npu_util, p_npu_tasks, p_npu_max_tasks, p_npu_clock,
            p_llm_role, False, "magenta"
        )
    else:
        n1_box = build_node_card(
            "NODE 1: bosgame1 (Master)", "Orchestrator", "bosgame1", p_uptime,
            p_cpu, p_cpu_temp, p_gpu_busy, p_sclk, p_mclk, p_power, p_gpu_temp,
            p_vram_used, p_vram_total, p_ram_used, p_ram_total,
            p_npu_avail, p_npu_tops, p_npu_util, p_npu_tasks, p_npu_max_tasks, p_npu_clock,
            p_llm_role, False, "magenta"
        )
        n2_box = build_node_card(
            "NODE 2: bosgame2 (Worker)", "Compute Worker", "bosgame2", loc_uptime,
            cpu_pct, cpu_temp, gpu["busy"], gpu["sclk"], gpu["mclk"], gpu["power"], gpu["temp"],
            gpu["vram_used"], gpu["vram_total"], mem["system_used"], mem["system_total"],
            npu["available"], npu["tops"], npu["util_pct"], npu["tasks_active"], npu["tasks_max"], npu["clock_mhz"],
            loc_llm_role, True, "cyan"
        )

    node_grid = Table.grid(expand=True)
    node_grid.add_column(ratio=1)
    node_grid.add_column(ratio=1)
    node_grid.add_row(n1_box, n2_box)

    waveforms = build_waveforms_panel(hist, dma_mode)
    llm_info = peer.get("llm", {}) if (not is_n1 and peer) else {}
    llm_panel = build_llm_panel(llm_info)
    procs_panel = build_overview_processes(all_procs)

    return Group(header, node_grid, waveforms, llm_panel, procs_panel, footer)


def main():
    parser = argparse.ArgumentParser(description="STRIX-TOP v2.2: Dual Strix Halo Cluster Monitor")
    parser.add_argument("-i", "--interval", type=float, default=0.5, help="Refresh interval in seconds (default: 0.5)")
    parser.add_argument("--view", choices=[VIEW_OVERVIEW, VIEW_CORES, VIEW_PROCESSES], default=VIEW_OVERVIEW, help="Initial view")
    parser.add_argument("--once", action="store_true", help="Print a single snapshot and exit")
    args = parser.parse_args()

    local_host = socket.gethostname()
    hist = ClusterHistory()
    console = Console()

    if args.once:
        console.print(render_ui(
            hist, args.view, "vram", True, args.interval, False, False, local_host
        ))
        return

    key_reader = KeyReader()
    active_view = args.view
    sort_key = "vram"
    ai_only = True
    interval = max(0.1, min(5.0, args.interval))
    paused = False
    show_help = False

    sort_keys = ["vram", "ram", "pid"]
    view_list = [VIEW_OVERVIEW, VIEW_CORES, VIEW_PROCESSES]

    try:
        with Live(
            render_ui(hist, active_view, sort_key, ai_only, interval, paused, show_help, local_host),
            console=console,
            screen=True,
            refresh_per_second=int(1.0 / max(0.1, interval))
        ) as live:
            while True:
                # Poll keys
                key = key_reader.read_key(timeout=interval)
                if key:
                    if key in ("q", "Q", "\x03"):  # q or Ctrl+C
                        break
                    elif key in ("h", "?"):
                        show_help = not show_help
                    elif key in ("1", "o", "O"):
                        active_view = VIEW_OVERVIEW
                        show_help = False
                    elif key in ("2", "c", "C"):
                        active_view = VIEW_CORES
                        show_help = False
                    elif key in ("3", "p", "P"):
                        active_view = VIEW_PROCESSES
                        show_help = False
                    elif key == "\t":  # Tab
                        idx = (view_list.index(active_view) + 1) % len(view_list)
                        active_view = view_list[idx]
                        show_help = False
                    elif key in ("s", "S"):
                        idx = (sort_keys.index(sort_key) + 1) % len(sort_keys)
                        sort_key = sort_keys[idx]
                    elif key in ("a", "A"):
                        ai_only = not ai_only
                    elif key in ("+", "="):
                        interval = max(0.1, interval - 0.1)
                    elif key in ("-", "_"):
                        interval = min(5.0, interval + 0.1)
                    elif key == " ":
                        paused = not paused
                    elif key in ("r", "R"):
                        pass

                ui = render_ui(hist, active_view, sort_key, ai_only, interval, paused, show_help, local_host)
                live.update(ui)

    except KeyboardInterrupt:
        pass
    finally:
        key_reader.close()
        console.clear()
        print("strix-top exited cleanly.")
        sys.exit(0)


if __name__ == "__main__":
    main()
