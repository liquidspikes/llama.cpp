class KeyReader:
    """Non-blocking keyboard reader using termios."""
    def __init__(self):
        self.is_tty = sys.stdin.isatty()
        self.old_settings = None
        if self.is_tty:
            try:
                self.old_settings = termios.tcgetattr(sys.stdin)
                tty.setcbreak(sys.stdin.fileno())
            except Exception:
                self.old_settings = None

    def read_key(self, timeout: float = 0.0) -> Optional[str]:
        if not self.is_tty or self.old_settings is None:
            return None
        try:
            r, _, _ = select.select([sys.stdin], [], [], timeout)
            if r:
                ch = sys.stdin.read(1)
                if ch == "\x1b":
                    # Escape sequence (e.g. arrow keys)
                    r2, _, _ = select.select([sys.stdin], [], [], 0.05)
                    if r2:
                        ch += sys.stdin.read(2)
                return ch
        except Exception:
            return None
        return None

    def close(self):
        if self.is_tty and self.old_settings is not None:
            try:
                termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_settings)
            except Exception:
                pass


class ClusterHistory:
    """Ring buffers for multi-resource waveform telemetry."""
    def __init__(self, max_len: int = HISTORY_LEN):
        self.max_len = max_len
        self.cpu_history: List[float] = [0.0] * max_len
        self.gpu_history: List[float] = [0.0] * max_len
        self.npu_history: List[float] = [0.0] * max_len
        self.dma_history: List[float] = [0.0] * max_len

    def update(self, cpu: float, gpu: float, npu: float, dma: float):
        self.cpu_history.append(cpu)
        self.gpu_history.append(gpu)
        self.npu_history.append(npu)
        self.dma_history.append(dma)
        if len(self.cpu_history) > self.max_len:
            self.cpu_history = self.cpu_history[-self.max_len:]
            self.gpu_history = self.gpu_history[-self.max_len:]
            self.npu_history = self.npu_history[-self.max_len:]
            self.dma_history = self.dma_history[-self.max_len:]


def render_chart(
    data: List[float],
    height: int = 4,
    width: int = 24,
    min_v: float = 0.0,
    max_v: float = 100.0,
    primary_color: str = "cyan",
    high_color: str = "bold yellow",
    peak_color: str = "bold red"
) -> List[Text]:
    """Renders a multi-row Braille/Block waveform chart."""
    pts = list(data[-width:])
    if len(pts) < width:
        pts = [min_v] * (width - len(pts)) + pts

    lines = []
    total_steps = height * 8
    span = (max_v - min_v) if max_v > min_v else 1.0

    for row in range(height - 1, -1, -1):
        line = Text()
        row_min = row * 8
        row_max = (row + 1) * 8
        for val in pts:
            norm = max(0.0, min(1.0, (val - min_v) / span))
            h = norm * total_steps
            if h >= row_max:
                char = "█"
            elif h > row_min:
                frac = int(round(h - row_min))
                char = BLOCKS[max(0, min(8, frac))]
            else:
                char = " "

            if norm > 0.80:
                st = peak_color
            elif norm > 0.50:
                st = high_color
            elif norm > 0.15:
                st = primary_color
            else:
                st = "dim " + primary_color

            line.append(char, style=st if char != " " else "default")
        lines.append(line)
    return lines


def make_bar(percent: float, width: int = 11, fill_color: str = "cyan", empty_color: str = "grey23") -> Text:
    percent = max(0.0, min(100.0, percent))
    fill_len = int(round((percent / 100.0) * width))
    empty_len = width - fill_len
    t = Text()
    t.append("█" * fill_len, style=fill_color)
    t.append("░" * empty_len, style=empty_color)
    return t


_PREV_TOTAL_CPU: Optional[Tuple[int, int]] = None
_PREV_CORE_CPUS: Dict[str, Tuple[int, int]] = {}
_PREV_CPU_TIME: Optional[float] = None


def get_local_cpu_stats() -> Tuple[float, float, List[Dict[str, Any]]]:
    """Calculates overall CPU utilization, temperature, and per-core details."""
    global _PREV_TOTAL_CPU, _PREV_CORE_CPUS, _PREV_CPU_TIME
    now = time.time()

    total_idle, total_all = 0, 0
    core_raw: Dict[str, Tuple[int, int]] = {}

    try:
        with open("/proc/stat") as f:
            for line in f:
                parts = line.split()
                if not parts:
                    continue
                tag = parts[0]
                if tag == "cpu":
                    nums = [int(x) for x in parts[1:]]
                    total_idle = nums[3] + nums[4]
                    total_all = sum(nums)
                elif tag.startswith("cpu") and tag[3:].isdigit():
                    nums = [int(x) for x in parts[1:]]
                    c_idle = nums[3] + nums[4]
                    c_all = sum(nums)
                    core_raw[tag] = (c_idle, c_all)
    except Exception:
        pass

    temp_c = 0.0
    for tf in glob.glob("/sys/class/hwmon/hwmon*/temp1_input"):
        try:
            val = int(open(tf).read().strip())
            if 20000 < val < 110000:
                temp_c = val / 1000.0
                break
        except Exception:
            pass

    overall_pct = 5.0
    if _PREV_TOTAL_CPU is not None:
        p_idle, p_all = _PREV_TOTAL_CPU
        didle = total_idle - p_idle
        dtot = total_all - p_all
        if dtot > 0:
            overall_pct = max(0.0, min(100.0, (dtot - didle) / dtot * 100.0))

    _PREV_TOTAL_CPU = (total_idle, total_all)

    core_details: List[Dict[str, Any]] = []
    for cpu_idx in range(32):
        c_tag = f"cpu{cpu_idx}"
        pct = 0.0
        if c_tag in core_raw and c_tag in _PREV_CORE_CPUS:
            cur_idle, cur_all = core_raw[c_tag]
            prev_idle, prev_all = _PREV_CORE_CPUS[c_tag]
            cdidle = cur_idle - prev_idle
            cdtot = cur_all - prev_all
            if cdtot > 0:
                pct = max(0.0, min(100.0, (cdtot - cdidle) / cdtot * 100.0))

        if c_tag in core_raw:
            _PREV_CORE_CPUS[c_tag] = core_raw[c_tag]

        freq_mhz = 2000
        try:
            fq = int(open(f"/sys/devices/system/cpu/{c_tag}/cpufreq/scaling_cur_freq").read().strip())
            freq_mhz = fq // 1000
        except Exception:
            pass

        core_id = cpu_idx % 16
        ccd = 0 if core_id < 8 else 1
        smt = 0 if cpu_idx < 16 else 1

        if ccd == 0:
            role = "ROCm/Compute"
        elif core_id < 12:
            role = "USB4 tb0"
        else:
            role = "USB4 tb1"

        core_details.append({
            "cpu_idx": cpu_idx,
            "core_id": core_id,
            "ccd": ccd,
            "smt": smt,
            "pct": pct,
            "freq_mhz": freq_mhz,
            "role": role,
        })

    _PREV_CPU_TIME = now
    return overall_pct, temp_c, core_details


def get_local_gpu_stats() -> Dict[str, Any]:
    busy = 0.0
    vram_used = 0.0
    vram_total = 64.0
    gtt_used = 0.0
    sclk = "2900MHz"
    mclk = "1000MHz"
    power = 0.0
    temp = 0.0

    dev_dir = None
    for card in glob.glob("/sys/class/drm/card[0-9]*/device"):
        if os.path.exists(f"{card}/mem_info_vram_total"):
            dev_dir = card
            break

    if dev_dir and os.path.exists(dev_dir):
        try:
            if os.path.exists(f"{dev_dir}/gpu_busy_percent"):
                busy = float(open(f"{dev_dir}/gpu_busy_percent").read().strip())
        except Exception:
            pass

        try:
            if os.path.exists(f"{dev_dir}/mem_info_vram_used"):
                vram_used = int(open(f"{dev_dir}/mem_info_vram_used").read().strip()) / (1024**3)
            if os.path.exists(f"{dev_dir}/mem_info_vram_total"):
                vram_total = int(open(f"{dev_dir}/mem_info_vram_total").read().strip()) / (1024**3)
            if os.path.exists(f"{dev_dir}/mem_info_gtt_used"):
                gtt_used = int(open(f"{dev_dir}/mem_info_gtt_used").read().strip()) / (1024**3)
        except Exception:
            pass

        try:
            if os.path.exists(f"{dev_dir}/pp_dpm_sclk"):
                for line in open(f"{dev_dir}/pp_dpm_sclk"):
                    if "*" in line:
                        sclk = line.split(":")[1].strip().split()[0]
            if os.path.exists(f"{dev_dir}/pp_dpm_mclk"):
                for line in open(f"{dev_dir}/pp_dpm_mclk"):
                    if "*" in line:
                        mclk = line.split(":")[1].strip().split()[0]
        except Exception:
            pass

        for p_file in glob.glob(f"{dev_dir}/hwmon/hwmon*/power1_average"):
            try:
                power = int(open(p_file).read().strip()) / 1_000_000.0
                break
            except Exception:
                pass
        for t_file in glob.glob(f"{dev_dir}/hwmon/hwmon*/temp1_input"):
            try:
                temp = int(open(t_file).read().strip()) / 1000.0
                break
            except Exception:
                pass

    return {
        "busy": busy,
        "vram_used": vram_used,
        "vram_total": vram_total,
        "gtt_used": gtt_used,
        "sclk": sclk,
        "mclk": mclk,
        "power": power,
        "temp": temp,
    }


def get_local_npu_stats() -> Dict[str, Any]:
    accel_dev = "/dev/accel/accel0"
    if not os.path.exists(accel_dev):
        return {"available": False, "tops": 0, "tasks_active": 0, "tasks_max": 16, "util_pct": 0.0, "clock_mhz": 0}

    h_clk = 1800
    tops_curr = 58
    tasks_curr = 0
    tasks_max = 16

    try:
        import struct, fcntl, ctypes
        IOC_NR = (3 << 30) | (16 << 16) | (ord('d') << 8) | (0x40 + 7)
        fd = os.open(accel_dev, os.O_RDWR)
        
        buf_clock = bytearray(64)
        buf_addr = ctypes.addressof((ctypes.c_char * 64).from_buffer(buf_clock))
        fcntl.ioctl(fd, IOC_NR, struct.pack('IIQ', 3, 64, buf_addr))
        h_clk = struct.unpack('I', buf_clock[40:44])[0]

        buf_res = bytearray(40)
        buf_addr = ctypes.addressof((ctypes.c_char * 40).from_buffer(buf_res))
        fcntl.ioctl(fd, IOC_NR, struct.pack('IIQ', 12, 40, buf_addr))
        clk_max, tops_max_val, task_max_val, tops_curr_val, task_curr_val = struct.unpack('QQQQQ', buf_res)
        tops_curr = tops_curr_val
        tasks_curr = task_curr_val
        tasks_max = task_max_val
        os.close(fd)
    except Exception:
        pass

    flm_busy = False
    try:
        for p_stat in glob.glob("/proc/[0-9]*/stat"):
            try:
                with open(p_stat, "r") as sf:
                    line = sf.read()
                    if "flm-real" in line or "flm" in line:
                        if line.split()[2] == "R":
                            flm_busy = True
                            break
            except Exception:
                pass
    except Exception:
        pass

    if tasks_curr > 0:
        ratio = tasks_curr / max(1, tasks_max)
        util_pct = min(100.0, max(50.0, (ratio * 100.0) + 35.0)) if flm_busy else (ratio * 100.0)
    elif flm_busy:
        util_pct = 75.0
    else:
        util_pct = 0.0

    return {
        "available": True,
        "tops": tops_curr,
        "tasks_active": tasks_curr,
        "tasks_max": tasks_max,
        "util_pct": round(util_pct, 1),
        "clock_mhz": h_clk
    }


def get_local_memory_stats() -> Dict[str, float]:
    total_unified = 128.0
    system_total = 62.4
    system_used = 0.0
    try:
        meminfo = {}
        with open("/proc/meminfo") as f:
            for line in f:
                if ":" in line:
                    k, v = line.split(":", 1)
                    meminfo[k.strip()] = int(v.split()[0])
        tot_kb = meminfo.get("MemTotal", 64 * 1024 * 1024)
        avail_kb = meminfo.get("MemAvailable", tot_kb // 2)
        system_total = tot_kb / (1024**2)
        system_used = (tot_kb - avail_kb) / (1024**2)
    except Exception:
        pass
    return {
        "total_unified": total_unified,
        "system_total": system_total,
        "system_used": system_used,
    }


_PREV_IO_BYTES: Optional[int] = None
_PREV_IO_TIME: Optional[float] = None


def get_local_dma_stats() -> Tuple[float, str, float]:
    global _PREV_IO_BYTES, _PREV_IO_TIME
    now = time.time()
    total_bytes = 0

    for p in glob.glob("/proc/[0-9]*"):
        try:
            comm = open(f"{p}/comm").read().strip()
            if comm.startswith(("llama-server", "rpc-server")):
                for line in open(f"{p}/io"):
                    if line.startswith("rchar:") or line.startswith("wchar:"):
                        total_bytes += int(line.split()[1])
        except Exception:
            pass

    rate_mbs = 0.0
    mode = "Idle"
    if _PREV_IO_BYTES is not None and _PREV_IO_TIME is not None:
        dt = max(0.1, now - _PREV_IO_TIME)
        dbytes = max(0, total_bytes - _PREV_IO_BYTES)
        rate_mbs = (dbytes / (1024**2)) / dt
        if rate_mbs > 50.0:
            mode = "Prompt Prefill / DMA Ingestion"
        elif rate_mbs > 1.0:
            mode = "AllReduce Ring Streaming"

    _PREV_IO_BYTES = total_bytes
    _PREV_IO_TIME = now
    return rate_mbs, mode, rate_mbs


def get_kfd_vram_map() -> Dict[int, float]:
    vram_by_pid = {}
    for p in glob.glob("/sys/class/kfd/kfd/proc/*"):
        pid_str = os.path.basename(p)
        if pid_str.isdigit():
            pid = int(pid_str)
            tot = 0
            for vf in glob.glob(f"{p}/vram_*"):
                try:
                    tot += int(open(vf).read().strip())
                except Exception:
                    pass
            if tot > 0:
                vram_by_pid[pid] = tot / (1024**3)
    return vram_by_pid


def get_local_processes(kfd_vram: Dict[int, float], all_procs: bool = False) -> List[Dict[str, Any]]:
    procs = []
    host = socket.gethostname()

    for p in glob.glob("/proc/[0-9]*"):
        try:
            pid = int(os.path.basename(p))
            comm = open(f"{p}/comm").read().strip()
            ai_keywords = ["llama", "rpc-server", "lemond", "lemonade", "grok", "muse", "quality_sweep"]
            is_ai = any(k in comm.lower() for k in ai_keywords)
            vram = kfd_vram.get(pid, 0.0)

            if not all_procs and not is_ai and vram == 0:
                continue

            cmdline = open(f"{p}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="ignore").strip()

            status = {}
            for line in open(f"{p}/status"):
                if ":" in line:
                    k, v = line.split(":", 1)
                    status[k.strip()] = v.strip()

            uid = int(status.get("Uid", "0").split()[0])
            try:
                user = pwd.getpwuid(uid).pw_name
            except Exception:
                user = str(uid)

            threads = int(status.get("Threads", "1"))
            rss_kb = int(status.get("VmRSS", "0 kB").split()[0])
            rss_gb = rss_kb / (1024**2)

            role = "System"
            if "llama-server" in comm:
                role = "Master (TP)"
            elif "rpc-server" in comm:
                role = "RPC Worker"
            elif "lemond" in comm or "lemonade" in comm:
                role = "Gateway :13306"
            elif "grok" in comm:
                role = "Grok AI Agent"
            elif "muse" in comm:
                role = "Muse AI Agent"
            elif "quality_sweep" in comm:
                role = "Quality Sweep"

            procs.append({
                "pid": pid,
                "node": host,
                "user": user,
                "role": role,
                "comm": comm,
                "threads": threads,
                "cpu_pct": 0.0,
                "rss_gb": rss_gb,
                "vram_gb": vram,
                "cmd": cmdline if cmdline else f"[{comm}]",
            })
        except Exception:
            pass

    return procs


def fetch_peer_data(peer_ip: str) -> Optional[Dict[str, Any]]:
    try:
        url = f"http://{peer_ip}:9090/api/local_stats"
        req = urllib.request.Request(url, headers={"User-Agent": "strix-top/2.2"})
        with urllib.request.urlopen(req, timeout=0.8) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return None


